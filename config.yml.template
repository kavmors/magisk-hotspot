# Strings must be enclosed in matching single or double quotes.
hotspot:
  ssid: ""
  password: ""
  # Supported values: "2.4GHz", "5GHz", "auto"
  band: "auto"

network:
  # Leave empty to keep Android's DHCP subnet unchanged. A configured /32 is
  # reachable through the hotspot's default route without replacing its subnet.
  ip_address: ""

dns:
  # Leave empty to disable DNS. Otherwise it resolves to network.ip_address,
  # or to the hotspot interface's Android-assigned address when that is empty.
  domain: ""

behavior:
  boot_delay_seconds: 15
  keep_alive: true
  retry_interval_seconds: 10
